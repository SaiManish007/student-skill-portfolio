# Root .gitignore for Student Skill & Project Portfolio System (Skillfolio)

# Environment variables
*.env
*.env.local
*.env.*.local
.env

# Maven & Java build output
**/target/
**/*.class
**/*.jar
**/*.war
**/*.nar
**/*.ear
**/*.zip
**/*.tar.gz
**/*.rar

# Frontend / Node build output & dependencies
**/node_modules/
**/dist/
**/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# OS / Scratch / Temporary
*.log
scratch/
tmp/
temp/
