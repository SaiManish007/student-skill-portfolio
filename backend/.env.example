# ==========================================================
# Skillfolio Backend Environment Variables (.env.example)
# Copy to .env or configure in Render / cloud dashboard
# ==========================================================

# Application Server Port
PORT=8080

# Spring Active Profile: local | prod | test
SPRING_PROFILES_ACTIVE=local

# Database Configuration:
# Either provide full DATABASE_URL (Render / Supabase / Heroku style):
# DATABASE_URL=postgres://username:password@hostname:5432/databasename
# Or individual Spring Datasource variables:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/skillfolio
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# JWT Security
# Ensure this secret is at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=SkillfolioSuperSecureSecretKeyThatIsAtLeast256BitsLongForHS256Security2026
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Bootstrap (Run once to create initial admin account, then disable)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@skillfolio.edu
ADMIN_BOOTSTRAP_PASSWORD=SecureAdminPassword2026!
ADMIN_BOOTSTRAP_NAME=System Administrator
